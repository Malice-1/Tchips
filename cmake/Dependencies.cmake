find_package(EnTT CONFIG REQUIRED)
if(TCHIPS_BUILD_CLIENT)
  find_package(SDL3 3.2 CONFIG REQUIRED)
endif()
if(TCHIPS_BUILD_TESTS)
  find_package(GTest CONFIG REQUIRED)
endif()
if(TCHIPS_ENABLE_NETWORK)
  find_package(GameNetworkingSockets CONFIG REQUIRED)
  find_package(Protobuf CONFIG REQUIRED)
  # Expose selected dependencies, without pretending to implement a transport.
  add_library(tchips_network_dependencies INTERFACE)
  if(TARGET GameNetworkingSockets::GameNetworkingSockets)
    target_link_libraries(tchips_network_dependencies INTERFACE GameNetworkingSockets::GameNetworkingSockets)
  elseif(TARGET GameNetworkingSockets::GameNetworkingSockets_s)
    target_link_libraries(tchips_network_dependencies INTERFACE GameNetworkingSockets::GameNetworkingSockets_s)
  else()
    message(FATAL_ERROR "No supported GameNetworkingSockets CMake target")
  endif()
  target_link_libraries(tchips_network_dependencies INTERFACE protobuf::libprotobuf)
endif()
if(TCHIPS_ENABLE_UI)
  if(NOT TCHIPS_BUILD_CLIENT)
    message(FATAL_ERROR "RmlUi is client-only; enable TCHIPS_BUILD_CLIENT")
  endif()
  find_package(RmlUi CONFIG REQUIRED)
endif()
if(TCHIPS_ENABLE_AUDIO)
  if(NOT TCHIPS_BUILD_CLIENT)
    message(FATAL_ERROR "miniaudio is client-only; enable TCHIPS_BUILD_CLIENT")
  endif()
  find_path(MINIAUDIO_INCLUDE_DIR miniaudio.h REQUIRED)
  add_library(tchips_miniaudio INTERFACE)
  target_include_directories(tchips_miniaudio SYSTEM INTERFACE "${MINIAUDIO_INCLUDE_DIR}")
endif()
if(TCHIPS_ENABLE_PERSISTENCE)
  if(NOT TCHIPS_BUILD_SERVER)
    message(FATAL_ERROR "libpqxx belongs to the server")
  endif()
  find_package(libpqxx CONFIG REQUIRED)
endif()
if(TCHIPS_ENABLE_PROFILING)
  find_package(Tracy CONFIG REQUIRED)
endif()
