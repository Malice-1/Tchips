cmake_minimum_required(VERSION 3.28)
get_filename_component(project_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(registry "${project_root}/.tools/vcpkg")
file(READ "${project_root}/vcpkg.json" manifest)
string(JSON baseline GET "${manifest}" builtin-baseline)
find_program(git_command git REQUIRED)
execute_process(COMMAND "${git_command}" -C "${registry}" rev-parse HEAD
  OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT actual STREQUAL baseline)
  message(FATAL_ERROR "Run tools/bootstrap.* to select pinned registry ${baseline}")
endif()
foreach(port IN ITEMS sdl3 entt gamenetworkingsockets protobuf rmlui miniaudio libpqxx gtest tracy)
  file(READ "${registry}/ports/${port}/vcpkg.json" definition)
  foreach(version_field IN ITEMS version version-semver version-string version-date)
    string(JSON version ERROR_VARIABLE version_error GET "${definition}" ${version_field})
    if(NOT version_error)
      break()
    endif()
  endforeach()
  if(version_error)
    message(FATAL_ERROR "No version found for ${port}")
  endif()
  message(STATUS "${port} ${version}: present in pinned registry, compilation not implied")
endforeach()
message(STATUS "SDL_GPU is part of SDL3. PostgreSQL server is a future runtime prerequisite.")
